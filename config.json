      "common_arguments_to_exclude": ["dataset_null_char", "csv_sep", "output_file_path"],
      "additional_arguments": {
        "mode": {
          "default": "hybrid",
          "type": "str"
        }
      }
    },
    "MISSDCEVIDENCE": {
      "approach_folder": "MISSDCEVIDENCE",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_MISSDC","python"],
      "common_arguments_to_exclude": ["dataset_null_char", "csv_sep", "output_file_path"],
      "additional_arguments": {
        "mode": {
          "default": "dc",
          "type": "str"
        },
        "min_evidence_multiplicity": {
          "default": null,
          "type": "str"
        }
      }
    },
    "MISSDCV2": {
      "approach_folder": "MISSDCV2",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_MISSDC","python"],
      "common_arguments_to_exclude": ["dataset_null_char", "csv_sep", "output_file_path"],
      "additional_arguments": {
        "mode": {
          "default": null,
          "type": "str"
        },
        "voting": {
          "default": null,
          "type": "str"
        },
        "min_evidence_multiplicity": {
          "default": null,
          "type": "str"
        },
        "dc_size_max": {
          "default": null,
          "type": "str"
        }
      }
    },
    "MISSFOREST": {
      "approach_folder": "MISSFOREST",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_MISSFOREST","python"]
    },
    "SIMPLEIMPUTER": {
      "approach_folder": "SIMPLEIMPUTER",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_SIMPLEIMPUTER","python"]
    },
    "TRIARD": {
      "approach_folder": "TRIARD",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_TRIARD","python"],
      "additional_arguments": {
        "dataset_null_char": {
          "type": "str",
          "default": "?"
        },
        "iterations": {
          "default": "3",
          "type": "str"
        },
        "min_score_to_reach": {
          "default": "0.5",
          "type": "str"
        }
      }
    },
    "DIFFPUTER": {
      "approach_folder": "DIFFPUTER",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_DIFFPUTER","python"],
      "additional_arguments": {
        "gpu": {
          "type": "int",
          "default": 0
        },
        "max_iter": {
          "type": "int",
          "default": 10
        },
        "hid_dim": {
          "type": "int",
          "default": 1024
        },
        "num_trials": {
          "type": "int",
          "default": 20
        },
        "num_steps": {
          "type": "int",
          "default": 50
        },
        "num_epochs": {
          "type": "int",
          "default": 1000
        }
      }
    },
    "CAFE": {
      "approach_folder": "CAFE",
      "imputation_script": "impute.py",
      "sys_exec": ["conda","run","-n","MISSDC_EXP_CAFE","python"],
      "additional_arguments": {
        "clients": {
          "type": "int",
          "default": 5
        },
        "rounds": {
          "type": "int",
          "default": 20
        },
        "seed": {
          "type": "int",
          "default": 42
        },
        "partition": {
          "type": "str",
          "default": "sample-evenly"
        }
      }
    }
  }
}